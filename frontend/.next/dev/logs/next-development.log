ow - partial expiry\",\"operations\":[],\"assertions\":[],\"description\":\"Sliding window should handle partial expiry correctly\",\"input\":\"const limiter = new RateLimiter(2, 1000);\\nassert(limiter.allowRequest(\\\"user1\\\", 0) === true);\\nassert(limiter.allowRequest(\\\"user1\\\", 100) === true);\\nassert(limiter.allowRequest(\\\"user1\\\", 200) === false);\"},{\"testCase\":\"TC7\",\"name\":\"high volume - 10 requests with limit 10\",\"operations\":[],\"assertions\":[],\"description\":\"Should handle high volume requests\",\"input\":\"const limiter = new RateLimiter(2, 1000);\\nassert(limiter.allowRequest(\\\"user1\\\", 0) === true);\\nassert(limiter.allowRequest(\\\"user1\\\", 100) === true);\\nassert(limiter.allowRequest(\\\"user1\\\", 200) === false);\"}]}","timeLimitMinutes":35,"title":"Rate Limiter"},"questionId":5,"scheduledAt":null,"showRunTests":false,"startedAt":"2026-01-09T15:17:00.335214","status":"in_progress"}
