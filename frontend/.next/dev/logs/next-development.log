\"Allows one too many or too few requests\",\"difficulty\":\"common\"},{\"name\":\"No window reset\",\"description\":\"Never allows new requests after window fills up\",\"difficulty\":\"hard\"}]}","primaryLanguage":"javascript","requirementsJson":"{\"requirements\":[\"Create a rate limiter with max requests and time window\",\"Implement allowRequest function\",\"Track request timestamps efficiently\",\"Handle time window expiration\",\"Support multiple independent limiters\"]}","rubricJson":"{\"categories\":[{\"category\":\"Correctness\",\"points\":25,\"description\":\"Basic solution passes tests\"},{\"category\":\"Edge Cases\",\"points\":15,\"description\":\"Handles edge cases (limit=1, empty, boundary)\"},{\"category\":\"Memory Efficiency\",\"points\":20,\"description\":\"Recognizes memory problem with high traffic\"},{\"category\":\"Alternative Solutions\",\"points\":20,\"description\":\"Discusses or implements memory-efficient alternative\"},{\"category\":\"AI Collaboration\",\"points\":20,\"description\":\"Uses AI effectively - asks good questions, reviews critically\"}]}","shortDescription":"Build a rate limiter that controls how many requests are allowed in a time window.\n\nEXAMPLE:\nconst limiter = new RateLimiter(3, 1000); // 3 requests per second\nlimiter.allowRequest(); // true\nlimiter.","status":"PUBLISHED","supportedLanguages":"java,python,javascript","testCases":[{"assertionsJson":"{\"r1\":true,\"r2\":true,\"r3\":true}","description":"3 requests with limit 3 should all be true","id":25,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[3,1000]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"}]","orderIndex":0,"passed":false,"testCase":"TC1","testName":"allows requests under limit"},{"assertionsJson":"{\"r1\":true,\"r2\":true,\"r3\":true,\"r4\":false}","description":"3rd request with limit 2 should be false","id":26,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[3,1000]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r4\"}]","orderIndex":1,"passed":false,"testCase":"TC2","testName":"blocks request when limit reached"},{"assertionsJson":"{\"r1\":true,\"r2\":false,\"r3\":false}","description":"After window expires, new requests should be allowed","id":27,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[1,1000]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"}]","orderIndex":2,"passed":false,"testCase":"TC3","testName":"allows request after window expires"},{"assertionsJson":"{\"r1\":true,\"r2\":false,\"r3\":true}","description":"Two limiters should track separately","id":28,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[1,100]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"sleep\",\"ms\":150},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"}]","orderIndex":3,"passed":false,"testCase":"TC4","testName":"each limiter is independent"},{"assertionsJson":"{\"r1\":true,\"r2\":true,\"r3\":false,\"r4\":false,\"r5\":true,\"r6\":true}","description":"Single request limit should work co