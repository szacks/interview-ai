[00:00:57.710] Browser LOG     [WebSocket] Received code update: {"interviewId":214,"payload":{"code":"// Rate Limiter\nimport java.util.*;\n\n\npublic class RateLimiter {\n    private int maxRequests;\n    private long windowMs;\n    private long windowStart;\n    private int requestCount;\n    \n    public RateLimiter(int maxRequests, long windowMs) {\n        this.maxRequests = maxRequests;\n        this.windowMs = windowMs;\n        this.windowStart = System.currentTimeMillis();\n        this.requestCount = 0;\n    }\n    \n    public boolean allowRequest() {\n        long now = System.currentTimeMillis();\n        \n        // If current time is outside the window, reset\n        if (now - windowStart >= windowMs) {\n            windowStart = now;\n            requestCount = 0;\n        }\n        \n        // Check if we can allow this request\n        if (requestCount < maxRequests) {\n            requestCount++;\n            return true;\n        }\n        \n        return false;\n    }\n}","endLine":null,"language":"java","startLine":null},"senderId":null,"timestamp":"2026-01-05T12:54:10.476528948","type":"code"}
