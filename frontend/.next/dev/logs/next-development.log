[00:00:04.089] Browser LOG     Latest code loaded: {"code":"// Rate Limiter\nimport java.util.*;\n\n\npublic class RateLimiter {\n    private int maxRequests;\n    private long windowMs;\n    private Queue<Long> requestTimes;\n    \n    public RateLimiter(int maxRequests, long windowMs) {\n        this.maxRequests = maxRequests;\n        this.windowMs = windowMs;\n        this.requestTimes = new LinkedList<>();\n    }\n    \n    public boolean allowRequest() {\n        long now = System.currentTimeMillis();\n        while (!requestTimes.isEmpty() && requestTimes.peek() < now - windowMs) {\n            requestTimes.poll();\n        }\n        \n        if (requestTimes.size() < maxRequests) {\n            requestTimes.add(now);\n            return true;\n        }\n        \n        return false;\n    }\n}","id":25,"language":"java","timestamp":"2026-01-05T12:49:31.510216"}
