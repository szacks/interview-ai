r2\":true,\"r3\":true,\"r4\":false}","description":"3rd request with limit 2 should be false","id":26,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[3,1000]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r4\"}]","orderIndex":1,"passed":false,"testCase":"TC2","testName":"blocks request when limit reached"},{"assertionsJson":"{\"r1\":true,\"r2\":false,\"r3\":false}","description":"After window expires, new requests should be allowed","id":27,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[1,1000]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"}]","orderIndex":2,"passed":false,"testCase":"TC3","testName":"allows request after window expires"},{"assertionsJson":"{\"r1\":true,\"r2\":false,\"r3\":true}","description":"Two limiters should track separately","id":28,"operationsJson":"[{\"type\":\"create\",\"class\":\"RateLimiter\",\"var\":\"limiter\",\"args\":[1,100]},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r1\"},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r2\"},{\"type\":\"sleep\",\"ms\":150},{\"type\":\"call\",\"var\":\"limiter\",\"method\":\"allowRequest\",\"store\":\"r3\"}]","orderIndex":3,"passed":false,"testCase":"TC4","testName":"each limiter is independent"},{"assertionsJson":"{\"r1\":true,\"r2\":true,\"r3\":false,\"r4\":false,\"r5\":true,\"r6\":true}","description":"Single request limit should work correctly","id