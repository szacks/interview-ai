[02:14:25.342] Browser LOG     [WebSocket] Received code update: {"interviewId":294,"payload":{"code":"class LogEntry {\n    long timestamp;\n    String level;\n    String message;\n    \n    LogEntry(long timestamp, String level, String message) {\n        this.timestamp = timestamp;\n        this.level = level;\n        this.message = message;\n    }\n}\n\nclass LogFilter {\n    String level;\n}\n\nclass Logger {\n    private List<LogEntry> logs = new ArrayList<>();\n    private long currentTime = 1000;\n    \n    public void write(String level, String message) {\n        logs.add(new LogEntry(currentTime, level, message));\n        currentTime++;\n    }\n    \n    public List<LogEntry> read(LogFilter filter) {\n        List<LogEntry> result = new ArrayList<>();\n        for (LogEntry log : logs) {\n            if (log.level.equals(filter.level)) {\n                result.add(log);\n            }\n        }\n        // Sort by timestamp descending (newest first)\n        result.sort((a, b) -> Long.compare(b.timestamp, a.timestamp));\n        return result;\n    }\n    \n    public int count(String level, long startTime, long endTime) {\n        int count = 0;\n        for (LogEntry log : logs) {\n            if (log.level.equals(level) && log.timestamp >= startTime && log.timestamp <= endTime) {\n                count++;\n            }\n        }\n        return count;\n    }\n}","endLine":null,"language":"java","startLine":null},"senderId":null,"timestamp":"2026-01-11T13:55:13.826513222","type":"code"}
